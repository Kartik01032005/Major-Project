# Use your computer's LAN IP when testing on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Optional: Google Maps Android API key for the embedded "Nearby" map.
# When unset, the map renders an informative fallback (no blank surface, no crash).
# Under Expo Go the bundled Expo-managed maps key is used automatically, so this is
# only needed for standalone/development-client builds. Never commit a real key.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
