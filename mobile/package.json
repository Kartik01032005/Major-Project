{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~57.0.15",
    "expo-constants": "~57.0.12",
    "expo-dev-client": "~57.0.14",
    "expo-linking": "~57.0.7",
    "expo-location": "~57.0.12",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev:setup": "node scripts/setup-dev-env.cjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "android:dev": "expo start --dev-client --android",
    "ios:dev": "expo start --dev-client --ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios"
  },
  "private": true
}
