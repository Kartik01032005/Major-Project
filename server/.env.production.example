# Production Environment Configuration for BloodLink Server (Express.js)
# Copy this file to .env or configure in your deployment platform (e.g. Render, Railway, AWS)

# Node Environment
NODE_ENV=production

# Server Port
PORT=5000

# MongoDB Atlas Production Connection URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/bloodlink?retryWrites=true&w=majority&appName=BloodLink

# Strong random secret key for JWT token generation (min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_random_string_here

# Token Expiry (e.g., 7d, 30d)
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS (your Vercel app domain)
CLIENT_URL=https://your-app.vercel.app
